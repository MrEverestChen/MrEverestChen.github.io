{
  "name": "vuepress-theme-plume",
  "type": "module",
  "version": "1.0.0-rc.213",
  "description": "A Blog&Document Theme for VuePress 2.0",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo/)",
  "license": "MIT",
  "homepage": "https://theme-plume.vuejs.press/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pengzhanbo/vuepress-theme-plume.git",
    "directory": "theme"
  },
  "bugs": {
    "url": "https://github.com/pengzhanbo/vuepress-theme-plume/issues"
  },
  "keywords": [
    "VuePress",
    "theme",
    "plume",
    "vuepress-theme",
    "vuepress-theme-plume",
    "theme-plume"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./components/*": {
      "import": "./dist/client/components/*"
    },
    "./composables": {
      "types": "./dist/client/composables/index.d.ts",
      "import": "./dist/client/composables/index.js"
    },
    "./features/*": {
      "import": "./dist/client/features/components/*"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "@iconify/json": ">=2",
    "@mathjax/src": "^4.1.3",
    "@vuepress/shiki-twoslash": "2.0.0-rc.135",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "pinyin-pro": "^3.29.4",
    "postprocessing": "^6.39.5",
    "swiper": "^14.3.0",
    "three": "^0.186.1",
    "vuepress": "2.0.0-rc.31"
  },
  "peerDependenciesMeta": {
    "@iconify/json": {
      "optional": true
    },
    "@mathjax/src": {
      "optional": true
    },
    "@vuepress/shiki-twoslash": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "ogl": {
      "optional": true
    },
    "pinyin-pro": {
      "optional": true
    },
    "postprocessing": {
      "optional": true
    },
    "swiper": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify/utils": "^3.1.7",
    "@iconify/vue": "^5.0.3",
    "@pengzhanbo/utils": "^3.12.0",
    "@shikijs/colorized-brackets": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@vuepress-plume/plugin-fonts": "1.0.0-rc.213",
    "@vuepress-plume/plugin-search": "1.0.0-rc.213",
    "@vuepress/helper": "2.0.0-rc.135",
    "@vuepress/plugin-cache": "2.0.0-rc.137",
    "@vuepress/plugin-comment": "2.0.0-rc.137",
    "@vuepress/plugin-copy-code": "2.0.0-rc.137",
    "@vuepress/plugin-docsearch": "2.0.0-rc.137",
    "@vuepress/plugin-git": "2.0.0-rc.137",
    "@vuepress/plugin-llms": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-chart": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-hint": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-image": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-include": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-math": "2.0.0-rc.137",
    "@vuepress/plugin-nprogress": "2.0.0-rc.135",
    "@vuepress/plugin-photo-swipe": "2.0.0-rc.137",
    "@vuepress/plugin-reading-time": "2.0.0-rc.137",
    "@vuepress/plugin-replace-assets": "2.0.0-rc.137",
    "@vuepress/plugin-seo": "2.0.0-rc.137",
    "@vuepress/plugin-shiki": "2.0.0-rc.137",
    "@vuepress/plugin-sitemap": "2.0.0-rc.137",
    "@vuepress/plugin-watermark": "2.0.0-rc.135",
    "@vueuse/core": "^15.0.0",
    "chokidar": "5.0.0",
    "dayjs": "^1.11.23",
    "find-file-icon": "^1.0.0",
    "gray-matter": "^4.0.3",
    "hash-wasm": "^4.12.0",
    "js-yaml": "^5.4.2",
    "katex": "^0.19.0",
    "local-pkg": "^1.2.1",
    "nanoid": "^6.0.1",
    "p-map": "^7.0.8",
    "package-manager-detector": "^1.8.0",
    "picomatch": "^4.0.7",
    "rolldown": "^1.2.12",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuepress-plugin-md-power": "1.0.0-rc.213"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.537",
    "@pinyin-pro/data": "^1.3.1",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "pinyin-pro": "^3.29.4",
    "postprocessing": "^6.39.5",
    "swiper": "^14.3.0",
    "three": "^0.186.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "pnpm '/(copy|tsdown):watch/'",
    "build": "pnpm run tsdown && pnpm run copy",
    "clean": "rimraf --glob ./dist",
    "copy": "cpx \"src/**/*.{d.ts,vue,css,scss,jpg,png,woff2}\" dist",
    "copy:watch": "cpx \"src/**/*.{d.ts,vue,css,scss,jpg,png,woff2}\" dist -w",
    "tsdown": "tsdown --config-loader unrun",
    "tsdown:watch": "tsdown --config-loader unrun --watch -- -c"
  }
}