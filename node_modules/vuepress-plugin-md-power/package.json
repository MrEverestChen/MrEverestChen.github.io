  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "pnpm '/(copy|tsdown):watch/'",
    "build": "pnpm tsdown && pnpm copy",
    "clean": "rimraf --glob ./dist",
    "copy": "cpx \"src/**/*.{d.ts,vue,css,scss,jpg,png}\" dist",
    "copy:watch": "cpx \"src/**/*.{d.ts,vue,css,scss,jpg,png}\" dist -w",
    "tsdown": "tsdown --config-loader unrun",
    "tsdown:watch": "tsdown --config-loader unrun --watch -- -c"
  }
}