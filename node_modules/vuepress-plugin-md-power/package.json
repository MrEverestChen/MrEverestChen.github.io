    "mpegts.js": "^1.8.2",
    "pyodide": "^314.0.7",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1",
    "stylus": "^0.64.0",
    "vuepress": "2.0.0-rc.31"
  },
  "peerDependenciesMeta": {
    "artplayer": {
      "optional": true
    },
    "dashjs": {
